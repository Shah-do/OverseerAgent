# Seerr / Overseerr connection
OVERSEERR_URL=http://192.168.1.36:5055
OVERSEERR_API_KEY=replace_with_your_seerr_api_key

# LLM provider: gemini or anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=replace_with_your_gemini_api_key

# Optional: select the Gemini model used for intent extraction.
# Set this to the model ID available to your Google AI API key.
GEMINI_MODEL=gemini-3.8-flash

# Host port mapped to the agent's internal port 4000
AGENT_PORT=4000
